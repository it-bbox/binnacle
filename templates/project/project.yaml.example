version: 1

project:
  id: example-project
  name: Example Project

tracker:
  provider: github # github | gitlab | local
  # Binnacle always reads the tracker and never writes to it (ADR-0013).
  local:
    # Used when provider is `local`. Tickets are files under <issues>/<slug>/issues/.
    issues: docs/specs

knowledge:
  context: CONTEXT.md
  docs: docs
  adr: docs/adr
  specs: docs/specs

workflow:
  provider: matt-pocock
  scratch: .scratch

capabilities:
  serena: true
  graphify: true
  context7: true
  ast_grep: true
  obsidian: optional

automation:
  mode: manual
  max_parallel_development_tasks: 2

telemetry:
  privacy: metadata
  import:
    # Asked at `binn init`. null imports the whole archive.
    window_days: 30
