version: 1

project:
  id: example-project
  name: Example Project

tracker:
  provider: github # github | gitlab | local
  # Binnacle always reads the tracker and never writes to it (ADR-0013).
  # Used when provider is `github` or `gitlab`: owner/name, or GitLab's full project path.
  repository: example-org/example-project
  # Optional: github.com or gitlab.com when unwritten; a hostname, or a base URL used as the API root.
  # host: github.example.com
  local:
    # Used when provider is `local`. Tickets are files under <issues>/<slug>/issues/.
    issues: docs/specs

knowledge:
  context: CONTEXT.md
  docs: docs
  adr: docs/adr
  specs: docs/specs
  # The language the repository is documented in: en | ru. Proposed at `binn init` from the
  # README, or from the person's locale without one. Unwritten, or another value, reads as en.
  language: en

workflow:
  provider: matt-pocock
  scratch: .scratch

capabilities:
  serena: true
  graphify: true
  context7: true
  ast_grep: true
  obsidian: optional

automation:
  mode: manual
  max_parallel_development_tasks: 2

telemetry:
  privacy: metadata
  import:
    # Asked at `binn init`: a number of days, or `all` for the whole archive. Unwritten, 90.
    window_days: 30
  context_pressure:
    # The context of a Product session's latest call, in tokens, from which the snapshot
    # suggests /binnacle:checkpoint (`context.pressure`). Unwritten, 150000.
    tokens: 150000
