{
  "name": "binnacle",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/it-bbox/binnacle.git"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"{apps,packages}/*/test/**/*.test.ts\"",
    "test:live": "node --test \"{apps,packages}/*/test/**/*.live.ts\"",
    "dashboard:generate": "pnpm --filter @binnacle/dashboard generate"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
